#!/usr/bin/env python3
"""Record one utterance and print its transcript.

Emits newline-delimited records on stdout:

    STATE listening | STATE transcribing
    TEXT  <what was said>
    ERROR <why nothing was said>

Local only: pw-record captures, whisper.cpp transcribes, nothing is sent
anywhere. The whisper model is shared with Nida when that is installed, so
dictation costs no extra download on a machine that already speaks.
"""

from __future__ import annotations

import array
import json
import math
import os
import shutil
import subprocess
import sys
import tempfile
import wave
from pathlib import Path

RATE = 16000
CHANNELS = 1
CHUNK_SAMPLES = 512

# Stop once speech has clearly ended, but never hold the microphone forever.
MIN_SPEECH_MS = 260
SILENCE_MS = 900
MAX_MS = 20000
CALIBRATE_MS = 220

HOME = Path.home()
MODEL_CANDIDATES = [
    HOME / ".local/share/nida/models/ggml-base.en.bin",
    HOME / ".local/share/lamha/models/ggml-base.en.bin",
    Path("/usr/share/whisper.cpp/models/ggml-base.en.bin"),
]


def emit(kind: str, value: str = "") -> None:
    sys.stdout.write(f"{kind} {value}".rstrip() + "\n")
    sys.stdout.flush()


def die(message: str) -> None:
    emit("ERROR", message)
    sys.exit(1)


def whisper_model() -> Path:
    config = HOME / ".config/omarchy/nida/config.json"
    if config.exists():
        try:
            configured = json.loads(config.read_text()).get("whisper_model")
            if configured and Path(configured).exists():
                return Path(configured)
        except (json.JSONDecodeError, OSError):
            pass
    for candidate in MODEL_CANDIDATES:
        if candidate.exists():
            return candidate
    die("no whisper model found — install one with Nida's setup, or drop "
        "ggml-base.en.bin in ~/.local/share/lamha/models/")
    raise SystemExit(1)


def microphone() -> str:
    """The default source, unless it is a monitor of an output."""
    try:
        listing = subprocess.run(
            ["pactl", "list", "short", "sources"],
            capture_output=True, text=True, check=True).stdout
    except (OSError, subprocess.CalledProcessError):
        die("could not ask pipewire for a microphone")
        raise SystemExit(1)

    sources = [line.split("\t")[1] for line in listing.splitlines()
               if "\t" in line]
    real = [name for name in sources if not name.endswith(".monitor")]
    if not real:
        die("no microphone found — only monitor sources exist")
    try:
        default = subprocess.run(["pactl", "get-default-source"],
                                 capture_output=True, text=True,
                                 check=True).stdout.strip()
    except (OSError, subprocess.CalledProcessError):
        default = ""
    return default if default in real else real[0]


def rms(chunk: bytes) -> float:
    samples = array.array("h")
    samples.frombytes(chunk)
    if not samples:
        return 0.0
    total = sum(float(sample) * float(sample) for sample in samples)
    return math.sqrt(total / len(samples)) / 32768.0


def record() -> bytes:
    source = microphone()
    argv = ["pw-record", "--rate", str(RATE), "--channels", str(CHANNELS),
            "--format", "s16", "--latency", "32ms", "--target", source, "-"]
    try:
        proc = subprocess.Popen(argv, stdout=subprocess.PIPE,
                                stderr=subprocess.DEVNULL)
    except OSError as exc:
        die(f"could not start pw-record: {exc}")
        raise SystemExit(1)

    chunk_bytes = CHUNK_SAMPLES * 2
    chunk_ms = (CHUNK_SAMPLES / RATE) * 1000.0

    frames: list[bytes] = []
    noise: list[float] = []
    threshold = 0.02
    elapsed = speech = silence = 0.0
    speaking = False

    emit("STATE", "listening")
    try:
        while True:
            chunk = proc.stdout.read(chunk_bytes)
            if not chunk:
                break
            frames.append(chunk)
            elapsed += chunk_ms
            level = rms(chunk)

            # The first fraction of a second is the room, not the speaker.
            if elapsed <= CALIBRATE_MS:
                noise.append(level)
                continue
            if noise and threshold == 0.02:
                floor = sum(noise) / len(noise)
                threshold = max(0.012, floor * 3.2)

            if level >= threshold:
                speaking = True
                speech += chunk_ms
                silence = 0.0
            elif speaking:
                silence += chunk_ms

            if speaking and speech >= MIN_SPEECH_MS and silence >= SILENCE_MS:
                break
            if elapsed >= MAX_MS:
                break
    finally:
        proc.terminate()
        try:
            proc.wait(timeout=1)
        except subprocess.TimeoutExpired:
            proc.kill()

    if not speaking:
        die("heard nothing")
    return b"".join(frames)


def transcribe(pcm: bytes, model: Path) -> str:
    binary = shutil.which("whisper-cli") or shutil.which("whisper.cpp")
    if binary is None:
        die("whisper-cli is not installed")

    with tempfile.TemporaryDirectory(prefix="lamha-") as workdir:
        wav_path = Path(workdir) / "utterance.wav"
        with wave.open(str(wav_path), "wb") as wav:
            wav.setnchannels(CHANNELS)
            wav.setsampwidth(2)
            wav.setframerate(RATE)
            wav.writeframes(pcm)

        emit("STATE", "transcribing")
        try:
            result = subprocess.run(
                [binary, "-m", str(model), "-f", str(wav_path),
                 "--no-timestamps", "--no-prints", "-t",
                 str(min(8, os.cpu_count() or 4)), "-l", "en"],
                capture_output=True, text=True, check=True)
        except subprocess.CalledProcessError as exc:
            die(f"whisper failed: {(exc.stderr or '').strip()[:160]}")
            raise SystemExit(1)

    lines = [line.strip() for line in result.stdout.splitlines() if line.strip()]
    return " ".join(lines).strip()


def main() -> None:
    model = whisper_model()
    text = transcribe(record(), model)
    # Whisper fills silence with its own punctuation; that is not a question.
    if not text or text.strip("._-—…") == "" or text in {"[BLANK_AUDIO]", "(silence)"}:
        die("heard nothing")
    emit("TEXT", text)


if __name__ == "__main__":
    main()
